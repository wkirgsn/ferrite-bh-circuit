* N87: 32-parameter B-H model (Kirchgaessner 2026), material equivalent circuit
* fitted on MagNet Challenge 2 data; trained temperatures [25.0, 50.0, 70.0] degC
* V(p,n) = N*Ae*dB/dt, current into p = H*le/N. Start from B = 0 (demagnetized).
.subckt N87_core p n params: Tc=25 N=1 Ae=1 le=1
.param tt={(Tc-50)/25}
.param a1={229.630447388+(-59.9574661255)*tt} a3={100*(-1.85733067989+(-2.73880338669)*tt)}
.param Bs={max(0.119140058756+(0.009566988796)*tt,0.15)} bw={exp(-2.45619916916)}
.param alpha={1/(1+exp(-(-1.51925098896+(-1.48680770397)*tt)))} kapa={-ln(1-alpha)/6.25e-08}
.param gc={1e-3*(10.8376893997+(-3.99011230469)*tt)}
.param r0={exp(-3.28336215019+(-0.198038101196)*tt)} w0={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(-1.33630497902))))} g0={gc+1e-3*(4.46943283081)*(-1.33630497902)}
.param r1={exp(-2.70290067792+(-0.198038101196)*tt)} w1={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(-0.801782987409))))} g1={gc+1e-3*(4.46943283081)*(-0.801782987409)}
.param r2={exp(-2.12243920565+(-0.198038101196)*tt)} w2={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(-0.267260995803))))} g2={gc+1e-3*(4.46943283081)*(-0.267260995803)}
.param r3={exp(-1.54197773337+(-0.198038101196)*tt)} w3={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(0.267260995803))))} g3={gc+1e-3*(4.46943283081)*(0.267260995803)}
.param r4={exp(-0.961516261101+(-0.198038101196)*tt)} w4={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(0.801782987409))))} g4={gc+1e-3*(4.46943283081)*(0.801782987409)}
.param r5={exp(-0.381054788828+(-0.198038101196)*tt)} w5={-ln(1+exp(-(-11.2185907364+(3.44489860535)*tt+(-2.71479701996+(3.12355184555)*tt)*(1.33630497902))))} g5={gc+1e-3*(4.46943283081)*(1.33630497902)}
.param c0={-ln(1+exp(8.47311782837+(-4.35822916031)*tt))} kapb0={-ln(1-0.5/(1+exp(-(-5.61831331253))))/6.25e-08} g6={gc+1e-3*(-48.5144615173)}
.param c1={-ln(1+exp(-0.0199148282409+(-2.18169975281)*tt))} kapb1={-ln(1-0.5/(1+exp(-(-16.1312427521))))/6.25e-08} g7={gc+1e-3*(-5.4730796814)}
Eu t 0 p n {1/(N*Ae)}
Vsense t c 0
Fport p n Vsense {le/N}
Gint 0 fl c 0 1
Cint fl 0 1
Rint fl 0 1e15
Fx 0 x Vsense 1
Lx x 0 1
Bmain c 0 I={a1}*V(fl)+{a3}*V(fl)*V(fl)*V(fl)+10*(exp(min((V(fl)-{Bs})/{bw},15))-exp(min((-V(fl)-{Bs})/{bw},15)))
Eg0 c d0 x 0 {-g0}
Gf0 0 f0 d0 0 1
Cf0 f0 0 1
Rf0 f0 0 1e15
Blin0 d0 0 I={w0}*V(f0)
Eb0 e0 0 d0 0 1
Lp0 e0 m0 {-1/w0}
Vs0 m0 a0 0
Bsl0 a0 0 V={kapa/(-w0)}*(max(I(Vs0)-{-w0*r0},0)+min(I(Vs0)+{-w0*r0},0))
Fm0 d0 0 Vs0 1
Eg1 c d1 x 0 {-g1}
Gf1 0 f1 d1 0 1
Cf1 f1 0 1
Rf1 f1 0 1e15
Blin1 d1 0 I={w1}*V(f1)
Eb1 e1 0 d1 0 1
Lp1 e1 m1 {-1/w1}
Vs1 m1 a1 0
Bsl1 a1 0 V={kapa/(-w1)}*(max(I(Vs1)-{-w1*r1},0)+min(I(Vs1)+{-w1*r1},0))
Fm1 d1 0 Vs1 1
Eg2 c d2 x 0 {-g2}
Gf2 0 f2 d2 0 1
Cf2 f2 0 1
Rf2 f2 0 1e15
Blin2 d2 0 I={w2}*V(f2)
Eb2 e2 0 d2 0 1
Lp2 e2 m2 {-1/w2}
Vs2 m2 a2 0
Bsl2 a2 0 V={kapa/(-w2)}*(max(I(Vs2)-{-w2*r2},0)+min(I(Vs2)+{-w2*r2},0))
Fm2 d2 0 Vs2 1
Eg3 c d3 x 0 {-g3}
Gf3 0 f3 d3 0 1
Cf3 f3 0 1
Rf3 f3 0 1e15
Blin3 d3 0 I={w3}*V(f3)
Eb3 e3 0 d3 0 1
Lp3 e3 m3 {-1/w3}
Vs3 m3 a3 0
Bsl3 a3 0 V={kapa/(-w3)}*(max(I(Vs3)-{-w3*r3},0)+min(I(Vs3)+{-w3*r3},0))
Fm3 d3 0 Vs3 1
Eg4 c d4 x 0 {-g4}
Gf4 0 f4 d4 0 1
Cf4 f4 0 1
Rf4 f4 0 1e15
Blin4 d4 0 I={w4}*V(f4)
Eb4 e4 0 d4 0 1
Lp4 e4 m4 {-1/w4}
Vs4 m4 a4 0
Bsl4 a4 0 V={kapa/(-w4)}*(max(I(Vs4)-{-w4*r4},0)+min(I(Vs4)+{-w4*r4},0))
Fm4 d4 0 Vs4 1
Eg5 c d5 x 0 {-g5}
Gf5 0 f5 d5 0 1
Cf5 f5 0 1
Rf5 f5 0 1e15
Blin5 d5 0 I={w5}*V(f5)
Eb5 e5 0 d5 0 1
Lp5 e5 m5 {-1/w5}
Vs5 m5 a5 0
Bsl5 a5 0 V={kapa/(-w5)}*(max(I(Vs5)-{-w5*r5},0)+min(I(Vs5)+{-w5*r5},0))
Fm5 d5 0 Vs5 1
Eg6 c d6 x 0 {-g6}
Gf6 0 f6 d6 0 1
Cf6 f6 0 1
Rf6 f6 0 1e15
Blin6 d6 0 I={c0}*V(f6)
Eb6 e6 0 d6 0 1
Lp6 e6 m6 {-1/c0}
Vs6 m6 a6 0
Rp6 a6 0 {kapb0/(-c0)}
Fm6 d6 0 Vs6 1
Eg7 c d7 x 0 {-g7}
Gf7 0 f7 d7 0 1
Cf7 f7 0 1
Rf7 f7 0 1e15
Blin7 d7 0 I={c1}*V(f7)
Eb7 e7 0 d7 0 1
Lp7 e7 m7 {-1/c1}
Vs7 m7 a7 0
Rp7 a7 0 {kapb1/(-c1)}
Fm7 d7 0 Vs7 1
.ends N87_core
