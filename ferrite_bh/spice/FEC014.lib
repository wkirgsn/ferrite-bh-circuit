* FEC014: 32-parameter B-H model (Kirchgaessner 2026), material equivalent circuit
* fitted on MagNet Challenge 2 data; trained temperatures [25.0, 50.0, 70.0] degC
* V(p,n) = N*Ae*dB/dt, current into p = H*le/N. Start from B = 0 (demagnetized).
.subckt FEC014_core p n params: Tc=25 N=1 Ae=1 le=1
.param tt={(Tc-50)/25}
.param a1={334.443084717+(-21.6595363617)*tt} a3={100*(-20.4862194061+(-0.149908974767)*tt)}
.param Bs={max(0.0725268721581+(0.0177164822817)*tt,0.15)} bw={exp(-2.42185497284)}
.param alpha={1/(1+exp(-(-1.22857785225+(-0.0160803087056)*tt)))} kapa={-ln(1-alpha)/6.25e-08}
.param gc={1e-3*(-0.307016402483+(-0.11706893146)*tt)}
.param r0={exp(-4.99989175797+(-0.0912014171481)*tt)} w0={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(-1.33630511455))))} g0={gc+1e-3*(0.325027495623)*(-1.33630511455)}
.param r1={exp(-4.34758441448+(-0.0912014171481)*tt)} w1={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(-0.801783068729))))} g1={gc+1e-3*(0.325027495623)*(-0.801783068729)}
.param r2={exp(-3.695277071+(-0.0912014171481)*tt)} w2={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(-0.26726102291))))} g2={gc+1e-3*(0.325027495623)*(-0.26726102291)}
.param r3={exp(-3.04296972752+(-0.0912014171481)*tt)} w3={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(0.26726102291))))} g3={gc+1e-3*(0.325027495623)*(0.26726102291)}
.param r4={exp(-2.39066238403+(-0.0912014171481)*tt)} w4={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(0.801783068729))))} g4={gc+1e-3*(0.325027495623)*(0.801783068729)}
.param r5={exp(-1.73835504055+(-0.0912014171481)*tt)} w5={-ln(1+exp(-(-39.9070358276+(2.99088811874)*tt+(-5.04919576645+(1.117613554)*tt)*(1.33630511455))))} g5={gc+1e-3*(0.325027495623)*(1.33630511455)}
.param c0={-ln(1+exp(2.75107240677+(-0.434511423111)*tt))} kapb0={-ln(1-0.5/(1+exp(-(-5.24583673477))))/6.25e-08} g6={gc+1e-3*(-12.7874193192)}
.param c1={-ln(1+exp(20.6582450867+(0.264408767223)*tt))} kapb1={-ln(1-0.5/(1+exp(-(11.204126358))))/6.25e-08} g7={gc+1e-3*(-27.3196430206)}
Eu t 0 p n {1/(N*Ae)}
Vsense t c 0
Fport p n Vsense {le/N}
Gint 0 fl c 0 1
Cint fl 0 1
Rint fl 0 1e15
Fx 0 x Vsense 1
Lx x 0 1
Bmain c 0 I={a1}*V(fl)+{a3}*V(fl)*V(fl)*V(fl)+10*(exp(min((V(fl)-{Bs})/{bw},15))-exp(min((-V(fl)-{Bs})/{bw},15)))
Eg0 c d0 x 0 {-g0}
Gf0 0 f0 d0 0 1
Cf0 f0 0 1
Rf0 f0 0 1e15
Blin0 d0 0 I={w0}*V(f0)
Eb0 e0 0 d0 0 1
Lp0 e0 m0 {-1/w0}
Vs0 m0 a0 0
Bsl0 a0 0 V={kapa/(-w0)}*(max(I(Vs0)-{-w0*r0},0)+min(I(Vs0)+{-w0*r0},0))
Fm0 d0 0 Vs0 1
